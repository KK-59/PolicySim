# Copy to .env — .env is gitignored, never commit the real values.

# NHS-SIM (Oriol's track — the only track that touches the live server)
NHSSIM_BASE_URL=
NHSSIM_TEAM_KEY=
NHSSIM_TIMEOUT_MS=8000

# OpenAI (extraction, brief, plan proposal — boundaries only, never the mechanism)
OPENAI_API_KEY=
OPENAI_MODEL=

# Demo safety: when true, the UI reads precomputed/grid.json and makes no network calls
VITE_OFFLINE_MODE=true
