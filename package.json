{
  "name": "policysim",
  "version": "0.1.0",
  "private": true,
  "description": "Every policy runs in three worlds. Team 14 — OpenAI x Anima Healthtech Hackathon.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,ui \"npm:dev:api\" \"vite\"",
    "dev:api": "tsx watch src/dashboard/server.ts",
    "start:api": "tsx src/dashboard/server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run && node tests/verify.ts",
    "test:watch": "vitest",
    "verify": "node tests/verify.ts",
    "typecheck": "tsc --noEmit",
    "snapshot": "tsx scripts/snapshot.mjs",
    "watch": "tsx scripts/watch.mjs",
    "grid": "tsx scripts/build-grid.ts",
    "liveloop": "tsx scripts/live-loop.mjs",
    "calibrate": "tsx scripts/calibrate.mjs",
    "corpus:build": "tsx scripts/build-corpus.mjs",
    "corpus:check": "tsx scripts/check-corpus.mjs",
    "ui-data": "tsx scripts/build-ui-data.ts"
  },
  "dependencies": {
    "mammoth": "^1.12.3",
    "pdfjs-dist": "^6.3.289",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.5",
    "dotenv": "^16.4.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
